<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SkiaTests\**" />
    <EmbeddedResource Remove="SkiaTests\**" />
    <None Remove="SkiaTests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.5.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SettlersOfIdlestan\SettlersOfIdlestanCore.csproj" />
    <!-- PerformanceTests/ valide le générateur d'états de fin de partie et le profileur d'horloge de
         SOIBench. La dépendance va bien dans ce sens : SOIBench ne connaît que le coeur du jeu. -->
    <ProjectReference Include="..\SOIBench\SOIBench.csproj" />
    <!-- StrategyTesterTests/ joue le race gauntlet de SOIStrategyTester (désactivé par défaut, voir
         RaceGauntletTests). Même sens de dépendance : SOIStrategyTester ne connaît que le coeur du
         jeu, jamais les tests. Apporte aussi ses Data/**/*.json en sortie, dont la stratégie que la
         manche joue. -->
    <ProjectReference Include="..\SOIStrategyTester\SOIStrategyTester.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
