<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>
    <!--
      Doit rester identique au nom de l'executable deja distribue : DesktopFileSystemService
      range les sauvegardes dans AppContext.BaseDirectory/saves. Un renommage de l'executable
      ou un changement de dossier d'installation ferait perdre leur partie aux joueurs Steam
      existants.
    -->
    <AssemblyName>SettlersOfIdlestan</AssemblyName>
  </PropertyGroup>

  <!--
    Build demo Steam. Reste a false dans le depot : c'est install\build_desktop_demo_*.bat qui
    passe -p:DemoBuild=true, de sorte que le mode demo depend du script lance et jamais de la
    branche checkoutee. La constante n'est lue que par MainWindow, qui force alors le drapeau
    demo au lieu de le lire sur la ligne de commande — un joueur ne peut pas retirer la
    restriction en enlevant l'argument de lancement du raccourci.
  -->
  <PropertyGroup>
    <DemoBuild Condition="'$(DemoBuild)' == ''">false</DemoBuild>
    <DefineConstants Condition="'$(DemoBuild)' == 'true'">$(DefineConstants);DEMO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <!--
      Bruitages : moteur audio multiplateforme adosse a miniaudio. Les binaires natifs voyagent
      dans le paquet et sont deposes par RID a la publication, comme ceux de SkiaSharp — les trois
      scripts install\build_desktop_*.bat n'ont rien de particulier a faire.
    -->
    <PackageReference Include="SoundFlow" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SettlersOfIdlestanUI\SettlersOfIdlestanUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\appicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeletePdbsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PdbToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbToDelete)" />
  </Target>

</Project>
